# رابط قاعدة بيانات Neon (من لوحة Neon ← Connection string، اختر Pooled connection)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# سر توقيع الجلسات — نص عشوائي طويل (Render يولّده تلقائياً)
JWT_SECRET=change-me
# كلمة المرور الأولى لحسابي hassan و haider (تُستخدم مرة واحدة فقط عند أول تشغيل)
INITIAL_ADMIN_PASSWORD=change-me
APP_TZ=Asia/Baghdad
PORT=3000
